{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "vs2022-x64",
      "displayName": "Visual Studio 2022 - x64",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "BREAKOUT_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "vs2022-x64-notests",
      "inherits": "vs2022-x64",
      "displayName": "Visual Studio 2022 - x64 (no tests)",
      "binaryDir": "${sourceDir}/build-notests",
      "cacheVariables": {
        "BREAKOUT_BUILD_TESTS": "OFF"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug",   "configurePreset": "vs2022-x64", "configuration": "Debug" },
    { "name": "release", "configurePreset": "vs2022-x64", "configuration": "Release" }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "vs2022-x64",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    }
  ]
}
